COMPOSE_PROJECT_NAME=auspex
TZ=UTC

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auspex
POSTGRES_USER=auspex_app
POSTGRES_PASSWORD=

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_SECRET_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=auspex-raw

# Backtest execution costs (services/backtesting market_sim.CostModel). Defaults shown.
USD_MIN_COMMISSION=1.00
IBKR_RATE_PER_SHARE=0.005
SPREAD_BPS=50
TOB_RATE=0.0035
BORROW_FEE_ANNUAL_PCT=3.0
# IBKR EUR/USD conversion fee, fraction of notional per leg (0.03%).
FX_FEE_RATE=0.0003
# Floor on the per-ticker half-spread estimate, in basis points per leg.
MIN_HALF_SPREAD_BPS=2.0
# Largest order as a fraction of 20-session average daily volume (market_sim.VolumeCap).
MAX_ADV_FRACTION=0.01

OPENAI_API_KEY=
# Registry key for the active extraction model — must exist in config/models/registry.yaml
# and have a passing gate record in config/models/scores/. For a local model this is the
# Ollama tag, e.g. llama3.1:8b-instruct-q8_0 (see docs/local-model-runbook.md).
EXTRACTION_MODEL=gpt-4o-mini-2024-07-18
# Optional: override the base URL. Ollama: http://host.docker.internal:11434/v1 from the
# Docker stack, http://localhost:11434/v1 for scripts run on the host.
# Absent → uses the OpenAI default endpoint.
EXTRACTION_BASE_URL=
# API key for the extraction endpoint. Falls back to OPENAI_API_KEY.
# For Ollama set to any non-empty string (e.g. "ollama").
EXTRACTION_API_KEY=
# Prompt file under services/ingestion-scraper/prompts/extraction/. Must match the gate record.
EXTRACTION_PROMPT_VERSION=v1.1

WATCHED_TICKERS=SRPT,SPRB,BEAM,CRSP,CAPR,ABVX,RCKT,QURE

EPO_OPS_KEY=
EPO_OPS_SECRET=

NCBI_API_KEY=

OPENFDA_API_KEY=

SEC_USER_AGENT=

ELASTIC_VERSION=8.17.3

PROMETHEUS_VERSION=v3.14.0

GRAFANA_VERSION=13.0.2
GRAFANA_ADMIN_PASSWORD=

UV_VERSION=0.12.17

SCRAPER_API_URL=http://ingestion-scraper:8000
CORE_HUB_URL=http://core-hub:8080

# Dashboard (services/dashboard), served on http://localhost:${DASHBOARD_PORT}. See SETUP.md for
# the secrets. The password hash goes in single quotes: bcrypt hashes contain `$`.
DASHBOARD_PORT=3001
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_IDLE_MINUTES=30
# Bearer token core-hub requires on every write under /api; only the dashboard's server sends it.
CORE_HUB_WRITE_TOKEN=

# Price snapshots (services/backtesting). History start for a ticker with no snapshot yet;
# existing snapshots only gain new bars and never reach further back, so set this before the
# first `up`. 2013 covers the slow-signal study (2014 onward) with a year of lookback, and the
# event backfill window.
PRICE_HISTORY_START=2013-01-01
PRICE_API_URL=http://price-service:8001

# Point-in-time universe (config/universe/rules.yaml). SEC's nightly bulk archives of filer
# submissions and XBRL company facts; requests use SEC_USER_AGENT.
SEC_SUBMISSIONS_BULK_URL=https://www.sec.gov/Archives/edgar/daily-index/bulkdata/submissions.zip
SEC_COMPANYFACTS_BULK_URL=https://www.sec.gov/Archives/edgar/daily-index/xbrl/companyfacts.zip
# Filing indexes, read only for companies delisted before inline XBRL whose ticker SEC no longer
# keeps (a few hundred requests per build, paced under SEC's 10 per second).
SEC_ARCHIVES_URL=https://www.sec.gov/Archives/edgar/data
# Catalyst date panel (services/backtesting/scripts/build_catalyst_panel.py): EDGAR's quarterly
# full index, read once per quarter to find universe companies' 8-Ks, and the Federal Register
# API for FDA advisory committee meeting notices (no key).
SEC_FULL_INDEX_URL=https://www.sec.gov/Archives/edgar/full-index
FEDERAL_REGISTER_API_URL=https://www.federalregister.gov/api/v1/documents.json
# First month of config/universe/backfill_scope.yaml: the event backfill's companies are the
# universe members from here on, not over the universe's whole window (which starts in 2014).
# 2024-01 is the earliest start the backfill's cutoff guard allows any registered model.
BACKFILL_SCOPE_START=2024-01-01
