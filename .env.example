# Auspex — local development environment
# Copy this file to .env and fill in every blank value before running compose.
# Non-credential defaults are pre-filled. Credential vars are intentionally blank.

COMPOSE_PROJECT_NAME=auspex
TZ=UTC

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Docker Compose uses POSTGRES_USER as the superuser for the auspex database.
# In local dev, auspex_app is both the superuser and the app role.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auspex
POSTGRES_USER=auspex_app
POSTGRES_PASSWORD=

# Airflow metadata database — created by docker/postgres-init/01_airflow.sh
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# ── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=auspex-raw

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4o

# ── Ingestion config ─────────────────────────────────────────────────────────
WATCHED_TICKERS=SRPT,SPRB,BEAM,CRSP,CAPR,ABVX,RCKT,QURE

# ── EPO OPS (patents — register at developers.epo.org, free, email only) ────
EPO_OPS_KEY=
EPO_OPS_SECRET=

# ── NCBI (optional — raises E-utilities from 3 to 10 req/s) ─────────────────
NCBI_API_KEY=

# ── openFDA (optional — 1,000 req/day without key, 120,000 with) ─────────────
OPENFDA_API_KEY=

# ── SEC EDGAR (mandatory — returns 403 without it) ───────────────────────────
# Format: "Firstname Lastname email@example.com"
SEC_USER_AGENT=
