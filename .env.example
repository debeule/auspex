COMPOSE_PROJECT_NAME=auspex
TZ=UTC

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auspex
POSTGRES_USER=auspex_app
POSTGRES_PASSWORD=

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_SECRET_KEY=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=auspex-raw

# Backtest execution costs (services/backtesting market_sim.CostModel). Defaults shown.
USD_MIN_COMMISSION=1.00
IBKR_RATE_PER_SHARE=0.005
SPREAD_BPS=50
TOB_RATE=0.0035
BORROW_FEE_ANNUAL_PCT=3.0
# IBKR EUR/USD conversion fee, fraction of notional per leg (0.03%).
FX_FEE_RATE=0.0003
# Floor on the per-ticker half-spread estimate, in basis points per leg.
MIN_HALF_SPREAD_BPS=2.0
# Largest order as a fraction of 20-session average daily volume (market_sim.VolumeCap).
MAX_ADV_FRACTION=0.01

OPENAI_API_KEY=
# Registry key for the active extraction model — must exist in config/models/registry.yaml
# and have a passing gate record in config/models/scores/. For a local model this is the
# Ollama tag, e.g. llama3.1:8b-instruct-q8_0 (see docs/local-model-runbook.md).
EXTRACTION_MODEL=gpt-4o-mini-2024-07-18
# Optional: override the base URL. Ollama: http://host.docker.internal:11434/v1 from the
# Docker stack, http://localhost:11434/v1 for scripts run on the host.
# Absent → uses the OpenAI default endpoint.
EXTRACTION_BASE_URL=
# API key for the extraction endpoint. Falls back to OPENAI_API_KEY.
# For Ollama set to any non-empty string (e.g. "ollama").
EXTRACTION_API_KEY=
# Prompt file under services/ingestion-scraper/prompts/extraction/. Must match the gate record.
EXTRACTION_PROMPT_VERSION=v1

WATCHED_TICKERS=SRPT,SPRB,BEAM,CRSP,CAPR,ABVX,RCKT,QURE

EPO_OPS_KEY=
EPO_OPS_SECRET=

NCBI_API_KEY=

OPENFDA_API_KEY=

SEC_USER_AGENT=

ELASTIC_VERSION=8.17.3

PROMETHEUS_VERSION=v3.14.0

GRAFANA_VERSION=13.0.2
GRAFANA_ADMIN_PASSWORD=

UV_VERSION=0.12.17

SCRAPER_API_URL=http://ingestion-scraper:8000
CORE_HUB_URL=http://core-hub:8080

# Dashboard (services/dashboard), served on http://localhost:${DASHBOARD_PORT}. See SETUP.md for
# the secrets. The password hash goes in single quotes: bcrypt hashes contain `$`.
DASHBOARD_PORT=3001
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_IDLE_MINUTES=30
# Bearer token core-hub requires on every write under /api; only the dashboard's server sends it.
CORE_HUB_WRITE_TOKEN=

# Price snapshots (services/backtesting). History start for a ticker with no snapshot yet;
# existing snapshots only gain new bars and never reach further back, so set this before the
# first `up`. 2013 covers the slow-signal study (2014 onward) with a year of lookback, and the
# event backfill window.
PRICE_HISTORY_START=2013-01-01
PRICE_API_URL=http://price-service:8001

# Point-in-time universe (config/universe/rules.yaml). SEC's nightly bulk archives of filer
# submissions and XBRL company facts; requests use SEC_USER_AGENT.
SEC_SUBMISSIONS_BULK_URL=https://www.sec.gov/Archives/edgar/daily-index/bulkdata/submissions.zip
SEC_COMPANYFACTS_BULK_URL=https://www.sec.gov/Archives/edgar/daily-index/xbrl/companyfacts.zip
# Filing indexes, read only for companies delisted before inline XBRL whose ticker SEC no longer
# keeps (a few hundred requests per build, paced under SEC's 10 per second).
SEC_ARCHIVES_URL=https://www.sec.gov/Archives/edgar/data
# Catalyst date panel (services/backtesting/scripts/build_catalyst_panel.py): EDGAR's quarterly
# full index, read once per quarter to find universe companies' 8-Ks, and the Federal Register
# API for FDA advisory committee meeting notices (no key).
SEC_FULL_INDEX_URL=https://www.sec.gov/Archives/edgar/full-index
FEDERAL_REGISTER_API_URL=https://www.federalregister.gov/api/v1/documents.json
# SEC ownership panels (services/backtesting, scripts/fetch_ownership.py): 13F holdings and
# insider transactions from SEC's quarterly data sets, listed on these pages; the days since the
# latest insider data set come from the daily form index, offerings from the quarterly one (SEC_FULL_INDEX_URL above).
# 13F data sets start in 2013 Q2, insider ones in 2006 Q1.
SEC_13F_DATASETS_URL=https://www.sec.gov/data-research/sec-markets-data/form-13f-data-sets
SEC_INSIDER_DATASETS_URL=https://www.sec.gov/data-research/sec-markets-data/insider-transactions-data-sets
SEC_DAILY_INDEX_URL=https://www.sec.gov/Archives/edgar/daily-index
OWNERSHIP_HISTORY_START=2013-01-01
# First month of config/universe/backfill_scope.yaml: the event backfill's companies are the
# universe members from here on, not over the universe's whole window (which starts in 2014).
# 2024-01 is the earliest start the backfill's cutoff guard allows any registered model.
BACKFILL_SCOPE_START=2024-01-01

# Nightly backup (services/backup; the auspex_backup DAG runs at 03:00 UTC). BACKUP_HOST_DIR is an
# absolute path on the Mac inside Docker Desktop's shared folders, e.g. /Users/<you>/auspex-backup.
# Dated Postgres and Neo4j copies older than BACKUP_KEEP_DAYS are pruned; the MinIO mirror is not.
BACKUP_HOST_DIR=
BACKUP_KEEP_DAYS=14
BACKUP_API_URL=http://backup:8002

# Infrastructure monitoring (Prometheus, Grafana alerting).
# Prometheus as Airflow reaches it, for the daily health summary (auspex_daily_health, 07:00 UTC),
# which is sent through the ALERT_CONTACT_TYPE and SMTP_* settings below.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=6GB
# Read-only role postgres-exporter logs in with; created or updated on every `up`.
POSTGRES_MONITOR_USER=auspex_monitor
POSTGRES_MONITOR_PASSWORD=
# Where every alert goes: email (ALERT_EMAIL_ADDRESSES, comma-separated, plus SMTP_*) or
# webhook (ALERT_WEBHOOK_URL).
ALERT_CONTACT_TYPE=email
ALERT_EMAIL_ADDRESSES=
ALERT_WEBHOOK_URL=
# SMTP server as host:port, e.g. smtp.gmail.com:587 with an app password.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Alert thresholds: percentages, restarts per hour, NYSE sessions.
ALERT_DOCKER_DISK_FREE_MIN_PCT=15
ALERT_MAC_DISK_FREE_MIN_PCT=10
ALERT_VM_MEMORY_MAX_PCT=90
ALERT_CONTAINER_RESTARTS_MAX_PER_HOUR=3
ALERT_PRICE_REFRESH_MAX_MISSED_SESSIONS=2
# Pipeline alerts: days without a stored signal from a source (Source Quiet), and the p95 of one
# extraction call over an hour, in seconds (Extraction Slow).
ALERT_SOURCE_QUIET_DAYS=5
ALERT_EXTRACTION_P95_SECONDS=60
# How often volume-usage measures the named volumes, in seconds.
VOLUME_USAGE_INTERVAL_SECONDS=900

# Container memory limits. Long-running services together stay within the 8 GB Docker Desktop
# VM, less 512 MB for the VM itself; one-shots run before the stack is busy and are not counted.
# A container at its limit is OOM-killed and restarted, which raises "Container Restarting".
KAFKA_MEM_LIMIT=576m
KAFKA_INIT_MEM_LIMIT=384m
POSTGRES_MEM_LIMIT=384m
NEO4J_MEM_LIMIT=512m
MINIO_MEM_LIMIT=320m
MINIO_INIT_MEM_LIMIT=256m
PRICE_BOOTSTRAP_MEM_LIMIT=1024m
PRICE_SERVICE_MEM_LIMIT=1024m
BACKUP_MEM_LIMIT=128m
RESTORE_MEM_LIMIT=512m
ELASTICSEARCH_MEM_LIMIT=768m
FILEBEAT_MEM_LIMIT=160m
ELASTICSEARCH_SETUP_MEM_LIMIT=32m
PROMETHEUS_MEM_LIMIT=320m
GRAFANA_MEM_LIMIT=256m
INGESTION_SCRAPER_MEM_LIMIT=384m
CORE_HUB_MEM_LIMIT=704m
DASHBOARD_MEM_LIMIT=256m
AIRFLOW_MEM_LIMIT=1536m
AIRFLOW_DB_ROLE_MEM_LIMIT=64m
AIRFLOW_STATE_INIT_MEM_LIMIT=32m
NODE_EXPORTER_MEM_LIMIT=48m
VOLUME_USAGE_MEM_LIMIT=32m
CADVISOR_MEM_LIMIT=160m
POSTGRES_MONITOR_ROLE_MEM_LIMIT=64m
POSTGRES_EXPORTER_MEM_LIMIT=48m
KAFKA_EXPORTER_MEM_LIMIT=48m
ELASTICSEARCH_EXPORTER_MEM_LIMIT=48m
BLACKBOX_EXPORTER_MEM_LIMIT=48m
STATSD_EXPORTER_MEM_LIMIT=48m
# JVM sizing inside those limits.
KAFKA_HEAP_OPTS=-Xmx384m -Xms384m
CORE_HUB_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60
# Neo4j heap (initial and max) and page cache; together at most 75% of NEO4J_MEM_LIMIT.
NEO4J_HEAP_SIZE=256m
NEO4J_PAGECACHE_SIZE=128m
# Airflow API server worker processes, and task processes LocalExecutor runs at once.
AIRFLOW_API_WORKERS=1
AIRFLOW_PARALLELISM=4
# Container log rotation (every service): size per file and files kept, so at most 60 MB each.
LOG_MAX_SIZE=20m
LOG_MAX_FILE=3
