# For `npm run dev` outside the stack. The compose service gets the same variables from the repo .env.
# Next expands $VAR in .env files: write each `$` of the password hash as `\$`.
CORE_HUB_URL=http://localhost:8080
SCRAPER_URL=http://localhost:8000
PRICE_SERVICE_URL=http://localhost:8001
CORE_HUB_WRITE_TOKEN=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_IDLE_MINUTES=30
