          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(source_type)(rate(auspex_pipeline_documents_fetched_total[$__rate_interval])) * 60",
          "legendFormat": "{{source_type}}"
